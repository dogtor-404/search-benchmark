ือนโบราณล้านนา สำนักส่งเสริมศิลปวัฒนธรรมและล้านนาสร้างสรรค์ ACCL มหาวิทยาลัยเชียงใหม่", "url": "https://accl.cmu.ac.th/Museum/exhibition/room1"}, {"title": "แฟชั่น การแต่งกายยุครัตนโกสินทร์ (ร.5-ปัจจุบัน )", "url": "https://boonsitablog.wordpress.com/2016/08/30/%E0%B9%81%E0%B8%9F%E0%B8%8A%E0%B8%B1%E0%B9%88%E0%B8%99-%E0%B8%81%E0%B8%B2%E0%B8%A3%E0%B9%81%E0%B8%95%E0%B9%88%E0%B8%87%E0%B8%81%E0%B8%B2%E0%B8%A2%E0%B8%A2%E0%B8%B8%E0%B8%84%E0%B8%A3%E0%B8%B1%E0%B8%95/"}, {"title": "มันมัณฑะเลย์จริงๆ (1/3)", "url": "https://www.goodreads.com/author_blog_posts/4068874-1-3"}, {"title": "การแต่งกายสมัย รัชกาลที่ 5", "url": "https://tanyapakblog.wordpress.com/2016/08/30/%E0%B8%9B%E0%B8%A3%E0%B8%B0%E0%B9%82%E0%B8%A2%E0%B8%8A%E0%B8%99%E0%B9%8C%E0%B8%82%E0%B8%AD%E0%B8%87%E0%B8%99%E0%B9%89%E0%B8%B3/"}, {"title": "ทีปกร วุฒิพิทยามงคล's Blog, page 66", "url": "https://www.goodreads.com/author/show/4951646._/blog?page=66"}, {"title": "มันมัณฑะเลย์จริงๆ (2/3)", "url": "https://www.goodreads.com/author_blog_posts/4274661-2-3?tab=book"}]}, "ผลการค้นหาไม่มีข้อมูลที่ตรงกับคำถามโดยตรง ไม่พบเอกสารที่ระบุว่าสตรีเชียงใหม่ห่มผ้าผืนเดียวแบบเฉวียงบ่าแล้วถือเป็นการแต่งกายสุภาพสำหรับการเข้าเฝ้า\n\nข้อมูลที่ใกล้เคียงที่สุดคือเรื่องการแต่งกายในสมัยรัชกาลที่ 5 ซึ่งเป็นภาพรวมของสยาม ไม่ได้เจาะจงเชียงใหม่ ทรงโปรดให้มีการประกาศสวมเสื้อเข้าเฝ้า แต่ในเวลาปกติแล้ว บรรดาขุนนาง เจ้านาย และเสนาบดียังนุ่งผ้าผืนเดียว ไม่สวมเสื้อ ซึ่งแสดงว่าการไม่สวมเสื้อในชีวิตประจำวันมีอยู่จริง แต่การเข้าเฝ้าต้องสวมเสื้อ ข้อมูลนี้ยังเป็นของราชสำนักกรุงเทพฯ ไม่ใช่ของล้านนา\n\nสำหรับเชียงใหม่ พิพิธภัณฑ์ ACCL มหาวิทยาลัยเชียงใหม่ระบุว่า ผู้หญิงนุ่งผ้าซิ่นตีนจก ทอด้วยผ้าไหมหรือผ้าฝ้ายลวดลายต่างๆ ห่มผ้าสะหว้ายด้วยผ้าแพรจีน และในสมัยรัชกาลที่ 5 นิยมนุ่งซิ่นต๋า สวมเสื้อผ้าฝ้าย แขนกระบอก ห่มผ้าสะหว้าย ซึ่งบ่งชี้ว่าสตรีล้านนามักสวมเสื้อร่วมกับผ้าห่ม ไม่ได้ไม่สวมเสื้อ\n\nหากต้องการคำตอบที่ยืนยันได้ แนะนำให้ค้นจากเอกสารประวัติศาสตร์ล้านนาหรือจากพิพิธภัณฑ์ในเชียงใหม่โดยตรง"], "durationSeconds": 7.899230416999999, "searchCount": 1}, "tool_result_meta": [{"id": "toolu_01D9GNT5g1sG3h986Er7LeMF", "permission_decision": {"decision": "accept", "source": "hook", "reason_type": "hook"}}]}
